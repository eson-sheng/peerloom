# Peerloom server configuration. Environment variables use the PEERLOOM_ prefix.
PEERLOOM_EXTERNAL_IP=
PEERLOOM_SECRET=
PEERLOOM_SERVER_TLS=false
PEERLOOM_TLS_CERT_FILE=
PEERLOOM_TLS_KEY_FILE=
PEERLOOM_SERVER_ADDRESS=0.0.0.0:5050
PEERLOOM_TURN_ADDRESS=0.0.0.0:3478
PEERLOOM_TURN_PORT_RANGE=
PEERLOOM_TURN_EXTERNAL_IP=
PEERLOOM_TURN_EXTERNAL_PORT=3478
PEERLOOM_TURN_EXTERNAL_SECRET=
PEERLOOM_TURN_DENY_PEERS=0.0.0.0/8,127.0.0.1/8,::/128,::1/128,fe80::/10
PEERLOOM_TRUST_PROXY_HEADERS=false
PEERLOOM_AUTH_MODE=turn
PEERLOOM_CORS_ALLOWED_ORIGINS=
# Setting a users file requires login to create rooms; guests may join existing rooms.
PEERLOOM_USERS_FILE=
PEERLOOM_SESSION_TIMEOUT_SECONDS=0
PEERLOOM_CLOSE_ROOM_WHEN_OWNER_LEAVES=true
PEERLOOM_LOG_LEVEL=info
PEERLOOM_PROMETHEUS=false

# Room capacity; voice is available to every member. Restart to apply.
PEERLOOM_MAX_ROOM_MEMBERS=12
PEERLOOM_MAX_MEDIA_SEATS=6
